# ==============================================================================
# Restro PRO - Production Environment Configuration
# Target Domain: http://pos.allkh.app/ (or http://pos.allkh.app:4001)
# Target IP:     10.36.200.125
# Production Port: 4001
# ==============================================================================

# Ingress Port (Host port mapped to Frontend Nginx)
PORT=4001

# Primary domain used for customer QR menus and emails
PRIMARY_FRONTEND_DOMAIN=https://pos.allkh.app

# CORS Whitelist: Comma-separated list of allowed origins (includes domain & IP, with & without port, http & https)
FRONTEND_DOMAIN=https://pos.allkh.app,http://pos.allkh.app,https://pos.allkh.app:4001,http://pos.allkh.app:4001,http://10.36.200.125:4001,http://10.36.200.125,http://rocky.tail5d006f.ts.net:4001,http://rocky.tail5d006f.ts.net,http://100.117.113.19:4001,http://100.117.113.19

# Cookie Domain Scope
# Left blank to allow seamless authentication on both pos.allkh.app and 10.36.200.125 (host-only cookie)
FRONTEND_DOMAIN_COOKIE=

# Cookie Security Flag (HTTP deployment requires false)
COOKIE_SECURE=false

# ==============================================================================
# Database Configuration (MySQL 8.0)
# ==============================================================================
DB_NAME=restropro_saas
DB_USER=restro
DB_PASSWORD=c0dff511b22abcb173dd07d7fa1cd0d6
DB_ROOT_PASSWORD=ec7338c8171f5f3d57a07cfca0c72c05

# Host Loopback bindings for maintenance (keeps DB & Redis inaccessible from outside network)
DB_PORT_BIND=127.0.0.1:3306
REDIS_PORT_BIND=127.0.0.1:6379
BACKEND_PORT_BIND=127.0.0.1:3000

# Optional Redis password (leave blank if internal-only)
REDIS_PASSWORD=

# ==============================================================================
# Authentication & Cryptographic Keys
# ==============================================================================
JWT_SECRET=f0e604f1a559c086e23247ada4d01516bfa1d2350e62ac4d28b6a9b2323f437e
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d
COOKIE_EXPIRY=900000
COOKIE_EXPIRY_REFRESH=2592000000
PASSWORD_SALT=10

# Symmetric encryption keys for sensitive database storage
ENCRYPTION_KEY=uiflow_prod_secret_salt_32char
CREDENTIAL_ENCRYPTION_KEY=dd82683b18811664549f0c9cdfffe2e69a6b3e33d85060233f0d0cdad0b251d5

# ==============================================================================
# Initial Superadmin Credentials (seeded into DB only on very first launch)
# ==============================================================================
