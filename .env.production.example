# ==============================================================================
# Restro PRO - Production Environment Configuration
# Target Domain: http://pos.allkh.app/ (or http://pos.allkh.app:4001)
# Target IP:     10.36.200.125
# Production Port: 4001
# ==============================================================================

# Ingress Port (Host port mapped to Frontend Nginx)
PORT=4001

# Primary domain used for customer QR menus and emails
PRIMARY_FRONTEND_DOMAIN=https://pos.allkh.app

# CORS Whitelist: Comma-separated list of allowed origins (includes domain & IP, with & without port, http & https)
FRONTEND_DOMAIN=https://pos.allkh.app,http://pos.allkh.app,https://pos.allkh.app:4001,http://pos.allkh.app:4001,http://10.36.200.125:4001,http://10.36.200.125,http://rocky.tail5d006f.ts.net:4001,http://rocky.tail5d006f.ts.net,http://100.117.113.19:4001,http://100.117.113.19,https://restro-pos.klebjeb.cloud,http://restro-pos.klebjeb.cloud

# Cookie Domain Scope
# - Set to "pos.allkh.app" if accessing strictly via domain name.
# - Leave BLANK to allow both domain (pos.allkh.app) and direct IP (10.36.200.125) access (RFC 6265 Host-Only Cookie).
FRONTEND_DOMAIN_COOKIE=

# Cookie Security Flag
# Keep "false" because site is served over HTTP (not HTTPS). Browsers reject Secure cookies over HTTP.
# Change to "true" only if you place an SSL-terminating reverse proxy (HTTPS) in front.
COOKIE_SECURE=false

# ==============================================================================
# Database Configuration (MySQL 8.0)
# ==============================================================================
DB_NAME=restropro_saas
DB_USER=restro
DB_PASSWORD=change_this_to_a_strong_password_123!
DB_ROOT_PASSWORD=change_this_to_a_strong_root_password_123!

# Host Loopback bindings for maintenance (keeps DB & Redis inaccessible from outside network)
DB_PORT_BIND=127.0.0.1:3306
REDIS_PORT_BIND=127.0.0.1:6379
BACKEND_PORT_BIND=127.0.0.1:3000

# Optional Redis password (leave blank if internal-only)
REDIS_PASSWORD=

# ==============================================================================
# Authentication & Cryptographic Keys
# ==============================================================================
# Generate 64-char hex string: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_random_hex_string_in_production
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d
COOKIE_EXPIRY=900000
COOKIE_EXPIRY_REFRESH=2592000000
PASSWORD_SALT=10

# Symmetric encryption keys for sensitive database storage (printer credentials, payment tokens)
ENCRYPTION_KEY=uiflow_prod_secret_salt_32char
CREDENTIAL_ENCRYPTION_KEY=cb78b647f4d0c4ff64163317440ff83bc14edd17bd92e100aff4a492f1911c0c

# ==============================================================================
# Initial Superadmin Credentials (seeded into DB only on very first launch)
# ==============================================================================
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin@123456

# ==============================================================================
# Optional Integrations
# ==============================================================================
# Stripe Subscriptions
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
STRIPE_PRODUCT_SUBSCRIPTION_KEY=price_1POsjYSCWiCS3BoQN2lnBMTz

# SMTP Email Relay
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Firebase Push Notifications (Mobile POS / Waiter App / Owner App)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_IOS_BUNDLE_ID=com.uiflow.waiterapp
FIREBASE_APNS_SANDBOX=false

# Automatic Day-End Reconciliation Summary Notification
DAY_END_RECONCILIATION_ENABLED=true
DAY_END_RECONCILIATION_TIME=23:59
DAY_END_RECONCILIATION_REPORT_ID=payment-summary
