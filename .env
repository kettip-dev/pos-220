# ========================================================
# RestroPro SaaS - Docker Compose Environment Configuration
# ========================================================

# Host Ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
DB_PORT=3306

# Database Configuration
DB_NAME=restropro_saas
DB_USER=restro
DB_PASSWORD=restropass
DB_ROOT_PASSWORD=rootpassword

# Backend Authentication & Security
JWT_SECRET=restro_jwt_secret_dev_key_change_in_production
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d
COOKIE_EXPIRY=900000
COOKIE_EXPIRY_REFRESH=2592000000
PASSWORD_SALT=10
FRONTEND_DOMAIN=http://localhost:5173,http://192.168.100.18:5173,http://10.36.202.17:5173
FRONTEND_DOMAIN_COOKIE=localhost
ENCRYPTION_KEY=uiflow
CREDENTIAL_ENCRYPTION_KEY=cb78b647f4d0c4ff64163317440ff83bc14edd17bd92e100aff4a492f1911c0c

# Optional Integrations (Stripe / SMTP)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=
SMTP_PASSWORD=

# Default Super Admin Credentials (seeded on first DB setup)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin@123456
