DATABASE_URL="mysql://test_user:test_pass@hostname_here/my_db_name"
JWT_SECRET=restro_jwt_secret
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d

# provide in ms - milliseconds => 15 minute, 30days | match the value to JWT expiry
COOKIE_EXPIRY=900000 # 15 minute (must match JWT_EXPIRY=15m)
COOKIE_EXPIRY_REFRESH=2592000000 # 30 day

PASSWORD_SALT=10
FRONTEND_DOMAIN="http://localhost:5173" # For Development: http://localhost:5173 # For Production: https://mydomain.com
FRONTEND_DOMAIN_COOKIE="localhost" # For Development: localhost # For Production: mydomain.com

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

ENCRYPTION_KEY=uiflow

# Firebase Admin SDK (push notifications for the waiter app).
# Provide ONE of the following:
#  - FIREBASE_SERVICE_ACCOUNT: full service account JSON as a single-line string
#  - FIREBASE_SERVICE_ACCOUNT_PATH: path to the service account JSON file
#  - GOOGLE_APPLICATION_CREDENTIALS: standard Google ADC path
# (Firebase console -> Project settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
# iOS: bundle id registered in Firebase, used to convert APNs tokens to FCM tokens.
FIREBASE_IOS_BUNDLE_ID=com.uiflow.waiterapp
# "true" while testing against development (sandbox) APNs builds.
FIREBASE_APNS_SANDBOX=false

# Owner App alerts
# Day-end reconciliation push: fired once per tenant per day at this time,
# read on the database clock so it matches the "today" report it summarises.
DAY_END_RECONCILIATION_ENABLED=true
DAY_END_RECONCILIATION_TIME=23:59
# Owner App report opened when the notification is tapped.
DAY_END_RECONCILIATION_REPORT_ID=payment-summary
# Low-stock pushes are coalesced per tenant over this window so a burst of
# orders produces one "N items are running low" alert. 0 = send immediately.
LOW_STOCK_ALERT_DEBOUNCE_MS=15000

