{
  "name": "restropro-print-agent",
  "version": "1.1.0",
  "description": "Restro PRO print agent: relays cloud POS print jobs to LAN and USB thermal printers inside the restaurant.",
  "main": "src/index.js",
  "bin": {
    "restropro-print-agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "list-printers": "node src/index.js --list-printers",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
